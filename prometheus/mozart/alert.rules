groups:
  - name: container-monitoring
    rules:
      - alert: container_disappeared
        expr: time() - container_last_seen{container_label_monitor_group="monitoring"} > 300
        for: 5m
        labels:
          severity: critical
        annotations:
          summary: "Container disappeared: {{ $labels.name }} on {{ $labels.hostname }}"
          description: "The container '{{ $labels.name }}' on '{{ $labels.hostname }}' has not been seen in cadvisor metrics for over 5 minutes."

      - alert: scrape_target_down
        expr: up == 0
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: "Scrape failure for {{ $labels.job }} on {{ $labels.hostname }}"
          description: "Prometheus failed to scrape the job '{{ $labels.job }}' (instance {{ $labels.instance }}) on '{{ $labels.hostname }}' for at least 2 minutes."

  # The alerting pipeline itself — "who watches the watcher".
  # Everything here routes to EMAIL (service="alerting" in alertmanager's config),
  # deliberately NOT Slack: these fire exactly when Slack delivery is broken, so a
  # Slack-routed self-alert would be a closed loop that can never report.
  - name: alerting-pipeline
    rules:
      # THE rule that would have caught the July 2026 outage on day one. Every
      # nh22 alert fired correctly for 9 days and every one died at the last hop
      # ("open /etc/alertmanager/slack_webhook_url: permission denied"), visible
      # only in alertmanager's own container log, which nothing read.
      - alert: AlertmanagerNotificationsFailing
        expr: rate(alertmanager_notifications_failed_total[10m]) > 0
        for: 15m
        labels:
          severity: critical
          service: alerting
        annotations:
          summary: "Alertmanager cannot deliver to {{ $labels.integration }}"
          description: "The '{{ $labels.integration }}' receiver has been failing to deliver for 15m+. Alerts are being generated and silently dropped. Check `docker logs alertmanager`."
          runbook: "Most likely causes: unreadable api_url_file (must be readable by uid 65534 `nobody`), an expired/revoked Slack webhook, or no egress. Verify with: docker exec alertmanager head -c 30 /etc/alertmanager/slack_webhook_url"

      # Prometheus lost its link to alertmanager entirely — nothing can be delivered.
      - alert: AlertmanagerUnreachable
        expr: up{job="alertmanager"} == 0
        for: 10m
        labels:
          severity: critical
          service: alerting
        annotations:
          summary: "Alertmanager is unreachable from Prometheus"
          description: "Prometheus has failed to scrape alertmanager for 10m+. Alert delivery is likely down entirely."

  # NightHawk22 direct-extraction pipeline (Spotify + YouTube Studio).
  # Metrics arrive via the node_exporter textfile collector as nh22_source_*.
  # Routing: kind=auth -> email (needs a human at a keyboard); kind=data|error -> Slack.
  - name: nh22-extractor
    rules:
      # Re-auth broken. auth_required is PERSISTED, so it stays 1 between runs rather than only
      # during them — which is what lets one threshold serve sources on different schedules.
      #
      # 65m was picked as ~2 consecutive hourly runs, when every source ran in the 07:00-14:00
      # hourly window. Read the number as a debounce, not a run count.
      #
      # EXCLUDES ascap and cdbaby (source!~"ascap|cdbaby"). Both crawl once (cdbaby: twice, see
      # ofelia.ini's 09:20 retry) a day, and nh22_source_auth_required for a once/twice-daily
      # source is only WRITTEN on that run — so after a human fixes the credential mid-day, this
      # persisted gauge sits at 1, unrewritten, until tomorrow's crawl. A bare rule on it pages
      # for up to ~24h against an already-fixed system. That is not hypothetical for cdbaby: on
      # 2026-08-05 the session was valid with 719h of credential left while the gauge still read
      # 1. ascap has the identical exposure — same once-a-day write, same persisted gauge — so it
      # is excluded here too, not left on this rule as previously reasoned. Both get a dedicated
      # alert below (NH22AscapSessionDead, NH22CdbabySessionDead) that ANDs this same gauge
      # against a session-validity signal measured independently every 10-20 minutes by that
      # source's 24/7 keepalive, so a session the keepalive can currently see as valid clears the
      # page immediately instead of waiting for the next scheduled crawl to overwrite the gauge.
      # spotify and yts stay on this bare rule unmodified: they run hourly in the 07:00-14:00
      # window, so the gauge is never more than about an hour stale and 65m is a real debounce,
      # not a wait for tomorrow. A future source with no dedicated gate defaults onto this rule
      # too, same as NH22ExtractorNotExtracting's bare arm below — only a source that has earned
      # its own session-validity carve-out gets excluded.
      - alert: NH22ExtractorAuthRequired
        expr: nh22_source_auth_required{source!~"ascap|cdbaby"} == 1
        for: 65m
        labels:
          severity: critical
          service: nh22-extractor
          kind: auth
        annotations:
          summary: "nh22 {{ $labels.source }} needs re-auth"
          description: "Source '{{ $labels.source }}' is reporting AUTH_REQUIRED and has been for over an hour. Scheduled extraction is blocked until you re-authenticate; the circuit-breaker is holding the browser back until then, so this will not clear on its own."
          runbook: "Easiest path for any source: open https://nh22-reauth.stevenc4.com/ — the auto-reauth supervisor spawns a console there within 15 minutes of the failure (07:00-21:59 MT) and waits for you, so there is usually nothing to start by hand. Otherwise, from nighthawk22-analytics: `make reauth SOURCE=<source>`. Per source — spotify: usually self-heals (scripted TOTP), needs a human only if a captcha appeared. yts: sign in at the noVNC URL. ascap: sign in AND clear the SMS code at the noVNC URL; extraction is daily at 05:30 MT, so a fix any time that day is in time for the next run. See nighthawk22-analytics/extractor/RUNBOOK.md and docs/AUTH_AUTOREAUTH.md."

      # Data-missing signal: alert only once we're missing MORE THAN 2 DAYS' worth
      # of data. last_success_timestamp advances daily in normal operation (age
      # stays under ~25h), so >48h means a full day was missed. Independent of the
      # run's self-reported status, so it catches silent breakage too. Guarded on
      # >0 so a brand-new deploy (never-succeeded) doesn't fire before first success.
      - alert: NH22DataStale
        expr: nh22_source_last_success_timestamp > 0 and (time() - nh22_source_last_success_timestamp) > 172800 and (time() - nh22_source_last_success_timestamp) <= 259200
        for: 15m
        labels:
          severity: warning
          service: nh22-extractor
          kind: data
        annotations:
          summary: "nh22 {{ $labels.source }} missing >2 days of data"
          description: "No confirmed-complete gate for '{{ $labels.source }}' in over 2 days."

      # Escalation: still missing after 3 days -> the pipeline is almost certainly broken.
      - alert: NH22DataStaleCritical
        expr: nh22_source_last_success_timestamp > 0 and (time() - nh22_source_last_success_timestamp) > 259200
        for: 15m
        labels:
          severity: critical
          service: nh22-extractor
          kind: data
        annotations:
          summary: "nh22 {{ $labels.source }} missing >3 days of data"
          description: "No confirmed-complete gate for '{{ $labels.source }}' in over 3 days. The pipeline is likely broken."

      # The extraction path is DEAD BEHIND A PASSING GATE — the third variant of
      # "the metric does not mean what you think" in this group (see absent() vs
      # stale below).
      #
      # NH22DataStale above watches last_success_timestamp, which advances whenever
      # the completeness GATE is satisfied — including on short-circuit runs that
      # never open a browser. So a source whose gate target is already in Postgres
      # reports perfectly healthy while its browser is broken. On 2026-07-23 a
      # stale Xvfb lock file broke every Chromium launch; spotify was caught
      # (its gate target was missing, so last_success froze) but yts sailed on,
      # because its lagged gate stayed satisfied from an earlier run's window.
      # Detection for yts would have taken ~4-5 days via DataStale.
      #
      # last_extraction_timestamp only advances when a browser run actually
      # completed, so it catches this directly. Thresholds differ per source
      # because cadence does: the gate targets today-(1+lag) while each run pulls
      # the whole 35-day window, so a source only re-extracts every lag+1 days.
      #   spotify: lag 0 -> extracts daily          -> 48h
      #   yts:     lag 1 -> extracts every 2nd day  -> 72h
      # The bare (unlabelled) arm is the 72h catch-all so a NEWLY ADDED source is
      # covered by default rather than silently unmonitored; spotify is then
      # tightened on top of it. If NH22_YTS_LAG_DAYS changes, re-derive 72h as
      # (lag+1) days + ~1 day of slack.
      #
      # Guarded on >0: the gauge is 0 until a source's first real extraction under
      # this state key, and an unguarded time()-0 fires instantly on deploy.
      - alert: NH22ExtractorNotExtracting
        expr: >-
          (nh22_source_last_extraction_timestamp > 0 and (time() - nh22_source_last_extraction_timestamp) > 259200)
          or
          (nh22_source_last_extraction_timestamp{source="spotify"} > 0 and (time() - nh22_source_last_extraction_timestamp{source="spotify"}) > 172800)
        for: 30m
        labels:
          severity: warning
          service: nh22-extractor
          kind: error
          # Thresholds are 48-72h, so this reads a signal that moves on a multi-day cadence.
          # See alertmanager/config.yml for what cadence=daily buys.
          cadence: daily
        annotations:
          summary: "nh22 {{ $labels.source }} has not actually extracted"
          description: "'{{ $labels.source }}' has not completed a real extraction in longer than its expected cadence, even though its completeness gate may still look satisfied. The browser/session path is probably broken."
          runbook: "Check `docker compose logs extractor` for 'FATAL: Xvfb failed to start' or a Chromium launch failure, then the auth sections. See nighthawk22-analytics/extractor/RUNBOOK.md#no-xserver."

      # PAYMENT DATA has stopped arriving — a different question from "did the crawl run".
      #
      # nh22_source_last_success_timestamp{source="cdbaby"} answers whether the CRAWL
      # completed, and the crawl runs daily. It says nothing about whether new payment
      # rows landed, and for a weekly-cadence feed those are different clocks: a
      # perfectly healthy Tuesday has no new payment data at all.
      #
      # THE GAP THIS EXISTS FOR (2026-08-18). CD Baby's payment-history scrape had been
      # failing on a stale-element race since 2026-08-09, and THREE signals read healthy
      # right through it:
      #   - the completeness gate kept advancing (the crawl really did finish), so
      #     NH22DataStale stayed quiet;
      #   - the scrape returned zero rows and reported ok, so the run looked clean;
      #   - ingest_assertion_config.cdbaby_payments.expected_max_lag_days is 60 —
      #     deliberately loose so a semi_automated source cannot hold the processor red
      #     for weeks — so is_stale never went true.
      # Fifteen days behind, and the 2026-08-10 weekly payment was lost for good: the
      # routine window is a trailing 7 days keyed on PAYMENT DATE, so it aged out.
      #
      # grain="day" IS LOAD-BEARING, NOT DECORATION. A month-grain dataset stamps every
      # row at the 1st, so its days_behind cycles 0-31 in perfect health — five CD Baby
      # and discover datasets were sitting at 17d while entirely fine. A rule over this
      # metric without the grain selector fires forever on all of them.
      #
      # THE THRESHOLD IS PROVISIONAL AND HERE IS HOW TO RETUNE IT. Payments are dated
      # weekly (every Monday, unbroken since April 2026). If CD Baby posts them promptly,
      # days_behind cycles 0-6 in health and 8 catches a single missed week immediately.
      # If CD Baby posts with a lag — the two most recent successful scrapes each found a
      # payment dated 6 days earlier, though that is confounded by the 7-day window's own
      # `from` edge, so it is weak evidence — the healthy ceiling is nearer 13 and this
      # will false-fire most of every week. That ambiguity was UNRESOLVABLE before this
      # metric existed. Watch nh22_ingest_dataset_days_behind{dataset="cdbaby_payments"}
      # for two weeks: if its healthy sawtooth peaks above 8, raise this to peak+3. Do
      # NOT just delete the rule.
      #
      # kind=data, so alertmanager's existing kind="data" route gives it
      # repeat_interval 24h: one notification, then at most one per day while it holds.
      # `for: 2h` rides out a processor pass landing mid-scrape.
      - alert: NH22PaymentDataStale
        expr: nh22_ingest_dataset_days_behind{dataset="cdbaby_payments",grain="day"} > 8
        for: 2h
        labels:
          severity: warning
          service: nh22-extractor
          kind: data
          cadence: daily
        annotations:
          summary: "nh22 CD Baby payment data is {{ $value }} days behind"
          description: "The newest row in payments.raw_cdbaby_payments is {{ $value }} days old. Payments are dated weekly (Mondays), so more than ~8 days means at least one weekly payment was never captured. The crawl may still be completing and reporting success — payment history returning ZERO rows counts as a clean run, which is exactly how this went unnoticed for 15 days in August 2026."
          runbook: "Check the payment-history step in `docker logs nh22-analytics-extractor-cdbaby-1` — a 'payment history failed' line, or 'payment history scraped 0 row(s)' on a day a payment was due. NOTE the routine window is a trailing 7 days keyed on payment date, so a payment missed for longer than that CANNOT be recovered by a normal run: re-run with a wider window, e.g. `docker compose run --rm -e NH22_SOURCES=cdbaby -e NH22_FORCE=true -e NH22_CDBABY_PAYMENTS_TRAILING_DAYS=30 extractor`. Verify with `select max(dt) from payments.raw_cdbaby_payments;`."

      # The EXPORTER behind the rule above has stopped writing.
      #
      # Same class of trap as NH22CdbabyKeepaliveStalled: NH22PaymentDataStale reads a
      # gauge published by a job, and if that job dies the gauge goes ABSENT rather than
      # bad. `> 8` can never match an absent series, so payment-staleness detection
      # silently disarms itself and the failure looks exactly like health.
      #
      # The export job runs hourly at :40; 3h allows two misses before this speaks.
      - alert: NH22IngestFreshnessExportStale
        expr: time() - nh22_ingest_freshness_export_timestamp > 10800
        for: 15m
        labels:
          severity: warning
          service: nh22-extractor
          kind: error
          cadence: daily
        annotations:
          summary: "nh22 ingest-freshness exporter has stopped writing"
          description: "nh22_ingest_freshness.prom has not been rewritten in over 3 hours (the job runs hourly at :40). While this fires, NH22PaymentDataStale is DISARMED — its threshold cannot match an absent series — so missing payment data will not alert."
          runbook: "`docker logs nh22-analytics-export-ingest-freshness-1`. If the container is missing, ensure-containers recreates it at :05; if ofelia itself is down, SchedulerDaemonDown will be firing too. The job is read-only, so restarting it is safe: `docker start -a nh22-analytics-export-ingest-freshness-1`."

      # ASCAP session keepalive (nh22_ascap_session_*, written by the 24/7
      # keepalive-ascap job, NOT by the extractor's nh22_source_* set).
      #
      # ASCAP's ma-api SESSION cookie lapses, taking the party binding with it, and a
      # bare `valid == 0` rule therefore alerts on healthy, self-healing behaviour.
      #
      # THE "ABSOLUTE 3h LIFETIME" THIS COMMENT USED TO ASSERT IS RETRACTED (2026-08-18).
      # It claimed nh22_ascap_session_longest_observed_seconds had plateaued at exactly
      # 10801s and never moved, which was the stated criterion for "absolute". That gauge
      # now reads 51600s (14h20m) — nearly 5x the supposed ceiling. A ceiling that gets
      # exceeded was never a ceiling; 10801s was a high-water mark mistaken for a plateau,
      # the same error made the same day for CD Baby's retracted 3599s. Session lifetime
      # is an OPEN QUESTION; do not write a schedule or a threshold against any fixed
      # number. The reason to gate this rule never depended on the lifetime anyway.
      #
      # It did. Between 2026-08-01 and 2026-08-02 this fired 7 times overnight on
      # routine expiries while extraction was fine, which is most of what made that
      # night's 26-email flood. A dead session is now only newsworthy if the
      # extractor is ACTUALLY BLOCKED by it — run-ascap.mjs re-binds the party on
      # demand, so a dead idle session is normally invisible to the crawl. The
      # `and on(instance)` gate is the whole fix: both series come from the same
      # node_exporter textfile collector, so they join on instance.
      #
      # What survives this gate is the case worth waking up for: the durable half
      # (the Cognito RefreshToken) is dead, and no re-bind can recover it.
      #
      # kind=auth, so it routes to nh22-auth (email + Cacau) like every other alert
      # that needs a person at a keyboard — which this does: the only fix is signing
      # in at the Zero Trust console, which auto-reauth will already have spawned.
      #
      # SINCE 2026-08-18 the keepalive REPAIRS a lapsed binding itself, and publishes
      # nh22_ascap_session_reauth_required — 1 only when an unattended re-bind was tried
      # and FAILED (the RefreshToken is dead), or when the session has gone 6 straight
      # ticks unrepaired (the backstop for a probe that errors rather than classifying,
      # which never reaches the re-bind path at all). That single series says exactly
      # what this rule spent two conjuncts approximating, so it is now the primary arm.
      # The old auth_required conjunct is kept as an OR: it is the extractor's
      # independent witness, and losing a second opinion on "must a human act" is not
      # worth the tidier expression.
      - alert: NH22AscapSessionDead
        expr: >-
          nh22_ascap_session_reauth_required == 1
          or
          (nh22_ascap_session_valid == 0 and on(instance) nh22_source_auth_required{source="ascap"} == 1)
        for: 90m
        labels:
          severity: critical
          service: nh22-extractor
          kind: auth
        annotations:
          summary: "nh22 ascap session is dead and extraction is blocked"
          description: "ASCAP needs a human: either the keepalive tried an unattended re-bind and it FAILED, or the session has gone unrepaired for 6+ straight checks, or the extractor is independently reporting AUTH_REQUIRED. This is not a routine party-binding lapse — those are re-bound automatically and never reach here."
          runbook: "Open https://nh22-reauth.stevenc4.com/ — auto-reauth spawns the console within 15 minutes (07:00-21:59 MT) and waits. ASCAP needs a password AND an SMS code. If nothing is waiting, run `make reauth SOURCE=ascap` in nighthawk22-analytics."

      # CD Baby session keepalive (nh22_cdbaby_session_*, written by the 24/7
      # keepalive-cdbaby job, NOT by the extractor's nh22_source_* set) — the CD Baby
      # half of the exclusion above, mirroring NH22AscapSessionDead exactly.
      #
      # The failure mode here is different from ASCAP's routine-3h-expiry flood, but
      # the fix is the same shape. extract-cdbaby runs once (twice since the 09:20
      # retry in ofelia.ini) a day, and nh22_source_auth_required{source="cdbaby"}
      # is written ONLY on that run. So once a human re-authenticates mid-day, the
      # persisted gauge does not clear until the next scheduled crawl overwrites it
      # — observed live on 2026-08-05: keepalive-cdbaby reported a valid session with
      # 719h of credential left while nh22_source_auth_required{source="cdbaby"}
      # still read 1. Left on the bare NH22ExtractorAuthRequired rule, that is a
      # guaranteed ~24h false page against an already-fixed system.
      #
      # The `and on(instance)` gate is the fix: AND the persisted, possibly-stale
      # auth_required flag against nh22_cdbaby_session_valid, which the keepalive
      # re-measures every 10 minutes independently of the crawl. A session the
      # keepalive can currently read as valid clears this alert immediately, without
      # waiting for tomorrow's run to rewrite the stale gauge. What survives the gate
      # is the case worth waking up for: auth_required is set AND the much-more-
      # frequently-sampled keepalive agrees the session is actually dead right now.
      #
      # for: 90m matches NH22AscapSessionDead's debounce. keepalive-cdbaby's 10-minute
      # cadence (vs. ascap's 20) settles nh22_cdbaby_session_valid well inside that,
      # so 90m is headroom against flapping, not a wait for enough samples.
      #
      # kind=auth, routing to nh22-auth (email + Cacau) like every other alert that
      # needs a person at a keyboard — which this does: the only fix is signing in,
      # which auto-reauth will already have spawned a console for.
      - alert: NH22CdbabySessionDead
        expr: nh22_cdbaby_session_valid == 0 and on(instance) nh22_source_auth_required{source="cdbaby"} == 1
        for: 90m
        labels:
          severity: critical
          service: nh22-extractor
          kind: auth
        annotations:
          summary: "nh22 cdbaby session is dead and extraction is blocked"
          description: "The CD Baby session has been failing for 90m+ AND the extractor is reporting AUTH_REQUIRED, so this is a genuine block rather than the persisted-gauge staleness a once/twice-daily source leaves behind after being fixed."
          runbook: "Open https://nh22-reauth.stevenc4.com/ — auto-reauth spawns the console within 15 minutes (07:00-21:59 MT) and waits. If nothing is waiting, run `make reauth SOURCE=cdbaby` in nighthawk22-analytics."

      # The keepalive itself stopped running. Distinct from the session being dead:
      # here we do not know the session's state at all. Since the 3h expiry is
      # absolute this no longer means "it will idle out" — the session was going to
      # die on schedule regardless. What is lost is the MEASUREMENT: the credential
      # monitor is blind, so a genuinely dead RefreshToken would no longer surface.
      # 70m = 3 missed ticks.
      - alert: NH22AscapKeepaliveStalled
        expr: time() - nh22_ascap_session_last_check_timestamp > 4200
        for: 15m
        labels:
          severity: warning
          service: nh22-extractor
          kind: error
        annotations:
          summary: "nh22 ascap keepalive has stopped checking"
          description: "No ASCAP session check in over 70 minutes (it runs every 20). The credential is unmonitored — a dead RefreshToken would now go unnoticed until a crawl fails."
          runbook: "`docker logs nh22-analytics-keepalive-ascap-1`. If the container is missing, ensure-containers recreates it at :05; if ofelia itself is down, SchedulerDaemonDown will be firing too."

      # THIS RULE IS WHAT KEEPS NH22CdbabySessionDead HONEST — it is not merely the
      # cdbaby twin of the ascap rule above.
      #
      # NH22CdbabySessionDead gates the CD Baby auth page on
      # `nh22_cdbaby_session_valid == 0`, which fixed a real problem (the
      # once-a-day auth_required gauge stays stuck at 1 for ~24h after a human has
      # already re-authenticated). But gating an alert on a metric makes the alert
      # only as reliable as that metric's publisher. If keepalive-cdbaby stops
      # writing, nh22_cdbaby_session_valid goes absent, `== 0` can never match, and
      # CD Baby auth failures page NOBODY — a strictly worse failure than the
      # 24h-of-noise problem the gate was added to solve, because it is silent.
      # ascap has carried this same structural dependency all along and is
      # backstopped by NH22AscapKeepaliveStalled above; cdbaby acquired the gate on
      # 2026-08-05 without the backstop, so this closes it in the same change.
      #
      # 40m = 4 missed ticks at the 10-minute cadence in ofelia.ini (ascap's 70m is
      # ~3.5 ticks at 20m). Deliberately more than 3 ticks: a tick that collides
      # with a running crawl logs "a scrape is in progress — skipping this tick" and
      # does NOT advance the timestamp, so a legitimately busy morning can drop two
      # in a row without anything being wrong.
      - alert: NH22CdbabyKeepaliveStalled
        expr: time() - nh22_cdbaby_session_last_check_timestamp > 2400
        for: 15m
        labels:
          severity: warning
          service: nh22-extractor
          kind: error
        annotations:
          summary: "nh22 cdbaby keepalive has stopped checking"
          description: "No CD Baby session check in over 40 minutes (it runs every 10). NH22CdbabySessionDead is gated on nh22_cdbaby_session_valid and is therefore DISARMED while this fires — a dead CD Baby session will not page until this is fixed."
          runbook: "`docker logs nh22-analytics-keepalive-cdbaby-1`. If the container is missing, ensure-containers recreates it at :05; if ofelia itself is down, SchedulerDaemonDown will be firing too. Until this clears, check CD Baby auth by hand: `docker compose run --rm extractor node src/run.mjs --sources cdbaby --dry-run` or just watch for the 06:20/09:20 crawl's own AUTH_REQUIRED log line."

      # The reauth reminder — the proactive "cdb.auth is running out" nudge, daily at
      # 05:10 MT (nighthawk22-analytics ofelia.ini, "reauth-reminder-cdbaby"). It writes
      # nh22_cdbaby_reauth_reminder.prom on EVERY run including quiet ones, so file mtime
      # is a true liveness signal rather than a signal of having something to say.
      #
      # It needs a rule of its own because the generic TextfileCollectorStale catch-all
      # cannot cover it: that rule's threshold is 1h, and a once-a-day writer is "stale"
      # by that definition for ~23 hours out of every 24. From 2026-08-05, when this
      # collector first appeared, that produced a warning every single day — roughly ten
      # emails a day at the default 2h repeat_interval — describing a job that was
      # working perfectly. The file is excluded from the catch-all below in the same
      # change; the exclusion and this rule are one unit and neither is correct alone.
      #
      # 30h, matching the budget convention used for the other daily nh22 jobs in
      # ONESHOT_TARGETS: it covers a DST-shifted gap between two 05:10 runs and still
      # catches a genuinely missed day well before the next one.
      #
      # Silence here is not cosmetic. This reminder is the only thing that warns a ~30-day
      # credential is expiring while there is still a working session to fix it from; if
      # it stops running, the first sign is a crawl that fails on dead auth.
      - alert: NH22CdbabyReauthReminderStale
        expr: time() - node_textfile_mtime_seconds{file=~"(.*/)?nh22_cdbaby_reauth_reminder\\.prom"} > 108000
        for: 30m
        labels:
          severity: warning
          service: nh22-extractor
          kind: error
          # The job this watches writes once a day at 05:10 MT, so the mtime it reads cannot
          # advance more than once a day either. See alertmanager/config.yml.
          cadence: daily
        annotations:
          summary: "nh22 cdbaby reauth reminder has stopped running"
          description: "nh22_cdbaby_reauth_reminder.prom has not been written in over 30 hours (the job runs daily at 05:10 MT and writes on every run). The proactive warning that the CD Baby credential is expiring is not being produced — the next sign of an expiring credential will be a crawl that fails on it."
          runbook: "`docker logs nh22-analytics-reauth-reminder-cdbaby-1` and check ./logs/ofelia in nighthawk22-analytics. If the container is missing, ensure-containers recreates it at :05; if ofelia itself is down, SchedulerDaemonDown will be firing too."

      # The reminder ran and had something to say, and could not say it. This is the
      # failure the reminder was built to make impossible: the direct-to-Slack post it
      # replaced was silently broken for 9 days in July 2026, and this rule is what
      # stops the replacement inheriting that property.
      #
      # BOTH conjuncts are required. delivery_success is 0 on a quiet run too — a run
      # with nothing to post reports attempted=0, success=0 — so the bare
      # `delivery_success == 0` would fire every day the credential was perfectly
      # healthy. That is the same shape as the two false positives fixed on 2026-08-06
      # and it is worth naming here so it is not "simplified" back in later.
      #
      # attempted=1 is set BEFORE the token check in reauth-reminder.mjs, so this covers
      # all three delivery failures, including the one that never reaches Slack at all:
      # an unset SLACK_BOT_TOKEN, a revoked/invalid one, and a bot that was never invited
      # to the channel (not_in_channel). The job also exits 1 in exactly these cases.
      #
      # ROUTED TO EMAIL AND SLACK, via kind=auth, deliberately. This fires precisely when
      # a Slack post failed, so a Slack-only route risks the closed loop that
      # `service="alerting"` exists to avoid. The two paths are not the same integration
      # — the reminder uses a bot token and chat.postMessage, Alertmanager uses an
      # incoming webhook — so the Slack copy usually still lands, and for the most likely
      # causes (revoked token, uninvited bot) it certainly does. But "usually" is not
      # something to route an alert on, hence the email. kind=auth is the only route that
      # yields both receivers, and it is a fair description: the fix is a human at a
      # keyboard repairing a credential.
      #
      # KNOWN GAP, accepted: the metric is rewritten on every run, so if the next day's
      # run has nothing to post (cooldown, or a band that dropped) this resolves while
      # the integration is still broken. Latching it would need state the reminder does
      # not publish. It re-fires the next time there is something to say, which is also
      # the next time it matters.
      - alert: NH22CdbabyReauthReminderUndelivered
        expr: nh22_cdbaby_reauth_reminder_post_attempted == 1 and nh22_cdbaby_reauth_reminder_delivery_success == 0
        for: 15m
        labels:
          severity: critical
          service: nh22-extractor
          kind: auth
        annotations:
          summary: "nh22 cdbaby reauth reminder could not deliver its warning"
          description: "The reminder decided the CD Baby credential needs attention and failed to post it to Slack. The warning that a ~30-day credential is expiring has been produced and thrown away — nobody has been told, and the next sign will be a crawl failing on dead auth."
          runbook: "`docker logs nh22-analytics-reauth-reminder-cdbaby-1` names the exact cause. not_in_channel: `/invite` the bot to the channel. invalid_auth/token_revoked or an unset token: fix SLACK_BOT_TOKEN in nighthawk22-analytics/.env. Then check the credential by hand — `nh22_cdbaby_reauth_reminder_seconds_left` says how long is left — and re-auth via `make reauth SOURCE=cdbaby` if it is short."

      # The most recent run for a source classified UNKNOWN and has stayed that way for 65m.
      #
      # This used to describe itself as "2+ consecutive hourly runs". That is true of the direct
      # sources — extract-direct-catchup runs every 10 minutes and extract-direct hourly, so 65m
      # really does span several failures for spotify and yts. It is false of everything else:
      # ascap runs once a day (0 30 5 * * *) and cdbaby once with one retry (06:20 / 09:20), so
      # for them the `for` clause cannot span two runs at all. The alert fired on a SINGLE failed
      # run while telling the reader it had seen two.
      #
      # Fixed by correcting the claim rather than by gating on a run count, because there is no
      # honest count to gate on: nh22_source_last_run_status has no companion cadence metric, and
      # the one countable signal that exists (nh22_source_run_attempts_today) sits at 1 all day
      # for ascap and cdbaby — requiring 2+ attempts would silence the daily sources permanently
      # instead of making them accurate. A single failed daily run is worth saying once.
      #
      # Saying it twelve times was the actual defect, and that is fixed in the routing tree:
      # this rule carries cadence=daily, which alertmanager/config.yml repeats every 24h.
      #
      # Observed 2026-08-11: one ascap run failed with "token refresh unreachable (Failed to
      # fetch)", a transient network error 3 seconds in. Because this is a LAST-RUN gauge and
      # nothing else was scheduled, UNKNOWN stayed pinned for a full 23.9h until the next day's
      # run overwrote it — which then succeeded untouched (57 statements, complete=true).
      - alert: NH22ExtractorRunError
        expr: nh22_source_last_run_status{status="UNKNOWN"} == 1
        for: 65m
        labels:
          severity: warning
          service: nh22-extractor
          kind: error
          cadence: daily
        annotations:
          summary: "nh22 {{ $labels.source }} run error (UNKNOWN)"
          description: "The last '{{ $labels.source }}' run classified UNKNOWN and has stayed that way for over an hour — check extractor container logs. This reflects the LAST run only and cannot clear until the next scheduled run succeeds, which for ascap and cdbaby is once a day."

      # Metrics stopped being written at all (textfile absent) — belt for the whole job.
      - alert: NH22ExtractorMetricsMissing
        expr: absent(nh22_source_last_run_timestamp)
        for: 3h
        labels:
          severity: warning
          service: nh22-extractor
          kind: error
        annotations:
          summary: "nh22 extractor metrics missing"
          description: "No nh22_source_* metrics for 3h — the extractor may not be running or the textfile mount is broken."

      # The job is not EXECUTING at all — distinct from executing and failing.
      #
      # NH22ExtractorMetricsMissing above cannot catch this, and did not: it uses
      # absent(), but the .prom file is a FILE. When the extractor stops running,
      # node_exporter happily keeps serving the last one it wrote, forever. The
      # series never goes absent, it goes STALE — so staleness is what to alert on.
      # In July 2026 the extractor container was deleted (a `docker system prune`
      # removes exited one-shots) and ofelia failed with "No such container" on
      # every tick for 9 days while this metric sat frozen and absent() stayed false.
      #
      # Normal cadence is 8 runs/day in the 07:00-14:00 MT window, so last_run
      # should never be older than ~24h. 30h clears a full window plus slack.
      - alert: NH22ExtractorNotRunning
        expr: nh22_source_last_run_timestamp > 0 and (time() - nh22_source_last_run_timestamp) > 108000
        for: 30m
        labels:
          severity: critical
          service: nh22-extractor
          kind: error
        annotations:
          summary: "nh22 {{ $labels.source }} extractor has not run in 30h"
          description: "The extractor has not EXECUTED for '{{ $labels.source }}' in over 30h — its metrics file is frozen, not missing. The scheduled job is not firing at all."
          runbook: "Check `docker compose logs ofelia | tail`. 'No such container' means the one-shot containers were removed (e.g. by docker system prune); recreate them with `make up` in nighthawk22-analytics."
  # Scheduled one-shot jobs across every stack on this host, from oneshot-exporter.
  #
  # Ofelia has no metrics endpoint of its own, so before this group the only job on the host
  # with any liveness monitoring was the nh22 extractor — and that only because the extractor
  # reports on itself. Everything else (importer, processor, garmin ingest, the five garmin
  # jobs, hopper-gmail, luiz-car-loan, configarr) could stop firing entirely and nothing would
  # notice. These rules read container state instead of asking the jobs to cooperate.
  #
  # Routing: all of these carry a `service` label ending in "-jobs" and none of them has a
  # Slack route, so they land on Alertmanager's default `email` receiver.
  - name: scheduled-jobs
    rules:
      # THE prune detector. This is the exact state that was invisible for 9 days in July 2026:
      # `docker system prune` removes exited one-shot containers, and Ofelia's `docker start`
      # then fails with "No such container" forever. ensure-containers now repairs this
      # automatically in every stack, so if this fires, the repair itself is broken.
      - alert: OneShotJobContainerMissing
        expr: oneshot_job_present == 0
        for: 10m
        labels:
          severity: critical
        annotations:
          summary: "Scheduled job container {{ $labels.container }} does not exist"
          description: "The container '{{ $labels.container }}' ({{ $labels.service }}) is gone, so its Ofelia schedule is failing with 'No such container' on every tick. Most likely a `docker system prune` removed it and that stack's ensure-containers job has not repaired it."
          runbook: "Run `make build down up` in the owning repo. If it recurs, ensure-containers is broken there — check its hardcoded project path, and prefer `docker image prune -a` over bare `docker system prune`."

      # Fires when a job has not completed within its own staleness budget. The threshold is
      # carried per-job as oneshot_job_max_age_seconds (set in the exporter's compose config
      # from each job's real schedule), so one rule covers a monthly report and a 15-minute
      # poll without either flapping or going blind.
      - alert: OneShotJobStale
        # Written as "overage > 0" rather than "age > budget" so $value is the amount by which
        # the job is late, which is what the annotation reports. `and last_finish > 0` excludes
        # containers that have never run — those are OneShotJobNeverRan, not stale.
        expr: (time() - oneshot_job_last_finish_seconds) - oneshot_job_max_age_seconds > 0 and oneshot_job_last_finish_seconds > 0
        for: 15m
        labels:
          severity: warning
        annotations:
          summary: "Scheduled job {{ $labels.container }} has not run within its budget"
          description: "'{{ $labels.container }}' ({{ $labels.service }}) last completed {{ $value | humanizeDuration }} beyond its staleness budget. The container exists, so this is a scheduler or job problem rather than a missing container."
          runbook: "Check `docker compose logs <scheduler>` in the owning repo, and ./logs/ofelia for a saved failure report."

      # The container exists but has never completed a run. Distinct from stale: this is what a
      # freshly recreated container looks like if the schedule that should start it is broken.
      #
      # "Never ran" is only evidence of a fault once the job has HAD a chance to run, and how
      # long that takes is the job's own cadence — so this compares container age against the
      # same per-job budget OneShotJobStale uses, rather than the flat 2h it used to. The two
      # rules now share one definition of late and stay consistent by construction.
      #
      # Without that gate this rule is unsound for anything slower than its timer, because
      # Docker resets FinishedAt to the zero value on recreation: a rebuild, a `compose up
      # --force-recreate`, or ensure-containers replacing a pruned container all make a job
      # that has run for years look like it has never run. Observed on 2026-08-05, when both
      # garmin fitness reports were recreated at 15:52: the weekly warned every 2h until the
      # following Sunday and the monthly would have kept warning until 1 September — ~300
      # emails about two containers that were exactly where they should be, waiting for a
      # schedule. The budgets absorb this correctly (216h weekly against a 7-day cadence, 840h
      # monthly against 31 days) while still catching a container that genuinely never starts.
      #
      # oneshot_job_created_seconds is emitted by the exporter for this rule. If it is ever
      # absent the `and` matches nothing and this rule silently stops firing rather than
      # reverting to the old behaviour — that is the tradeoff of a gated alert, and the same
      # one NH22CdbabySessionDead carries. The backstop is that the exporter publishes it for
      # every target in the same loop as oneshot_job_present, so it cannot go missing for one
      # job alone, and an exporter that stops writing entirely trips OneShotExporterStale.
      - alert: OneShotJobNeverRan
        expr: |
          oneshot_job_present == 1
            and oneshot_job_last_finish_seconds == 0
            and (time() - oneshot_job_created_seconds) > oneshot_job_max_age_seconds
        for: 2h
        labels:
          severity: warning
        annotations:
          summary: "Scheduled job {{ $labels.container }} has never run"
          description: "'{{ $labels.container }}' ({{ $labels.service }}) exists but has no completed run, and has now existed for longer than its own staleness budget — so it is past the point where its schedule should have started it at least once. If ensure-containers recreated it, the schedule that should start it may not be firing."

      # Last completed run failed. The metric persists between runs, so this stays firing until
      # a subsequent run succeeds — which is the intent: a job failing every hour should not
      # resolve itself between attempts.
      - alert: OneShotJobFailing
        expr: oneshot_job_last_exit_code != 0
        for: 15m
        labels:
          severity: warning
        annotations:
          summary: "Scheduled job {{ $labels.container }} exited {{ $value }}"
          description: "The last completed run of '{{ $labels.container }}' ({{ $labels.service }}) exited non-zero. It will keep firing until a run succeeds."
          runbook: "`docker logs {{ $labels.container }}` for the failure, and ./logs/ofelia in the owning repo for the saved report."

      # Who watches this watcher. The exporter self-loops rather than running under ofelia, so
      # its own death has to be caught by the freshness of the file it writes.
      - alert: OneShotExporterStale
        expr: time() - node_textfile_mtime_seconds{file=~"(.*/)?oneshot_jobs\\.prom"} > 300
        for: 10m
        labels:
          severity: critical
        annotations:
          summary: "oneshot-exporter has stopped writing"
          description: "oneshot_jobs.prom has not been updated in over 5 minutes (it writes every 60s). Every scheduled-job alert above is blind while this is true."

      - alert: OneShotExporterMissing
        expr: absent(node_textfile_mtime_seconds{file=~"(.*/)?oneshot_jobs\\.prom"})
        for: 15m
        labels:
          severity: critical
        annotations:
          summary: "oneshot-exporter metrics are absent entirely"
          description: "No oneshot_jobs.prom at all — the exporter has never run, or the textfile mount is broken. Every scheduled-job alert above is blind."

  # The schedulers themselves, from the same exporter (SCHEDULER_TARGETS).
  #
  # The group above watches jobs by their effect, which is sound and did its job on 2026-07-31:
  # nh22-analytics-ofelia-1 exited 1 on an unparseable config, and OneShotJobStale reported the
  # importer late at 01:41 and the processor at 01:51 — 3.5h after the scheduler died, correctly,
  # to email, with no delivery failures. Nothing here is fixing a missed detection.
  #
  # What it fixes is that the outage read as "two nh22 jobs are late (warning)" when it was "the
  # scheduler for this host is dead and NOTHING will fire (critical)". One cause, stated once, at
  # the severity the blast radius deserves. The two structural gaps are real too: a scheduler that
  # dies while every job is still inside its budget is invisible until the budgets expire, and one
  # that crash-loops on a bad config never ran anything to be late in the first place.
  - name: schedulers
    rules:
      # A scheduler that is not running schedules nothing. There is no partial version of this,
      # which is why it is critical at 10m while a single late job is a warning at 15m.
      - alert: SchedulerDaemonDown
        expr: scheduler_daemon_present == 1 and scheduler_daemon_running == 0
        for: 10m
        labels:
          severity: critical
        annotations:
          summary: "Scheduler {{ $labels.container }} is not running"
          description: "'{{ $labels.container }}' ({{ $labels.service }}) exists but is stopped, so every job it schedules has silently stopped firing. Expect OneShotJobStale to follow for each of them as their budgets expire."
          runbook: "`docker logs {{ $labels.container }} | tail -20`. Ofelia exits 1 on a config it cannot parse and says so in ONE line — an unknown key in a [job-run] section (e.g. `entrypoint`) is fatal for EVERY job, not just that one. Validate before restarting: `docker run --rm -v ./ofelia.ini:/etc/ofelia/config.ini:ro mcuadros/ofelia:latest validate --config /etc/ofelia/config.ini`."

      # Distinct from Down: nothing to restart, the container is gone. Same prune failure mode as
      # OneShotJobContainerMissing, but a scheduler's absence takes its whole stack with it.
      - alert: SchedulerDaemonMissing
        expr: scheduler_daemon_present == 0
        for: 10m
        labels:
          severity: critical
        annotations:
          summary: "Scheduler {{ $labels.container }} does not exist"
          description: "'{{ $labels.container }}' ({{ $labels.service }}) is not present on the host at all. Every job in that stack is unscheduled."
          runbook: "`make up` in the owning repo. Unlike the one-shot containers, no ensure-containers job can repair this — ensure-containers is itself run BY the scheduler that is missing."

      # Up, but dying repeatedly. Restarts are cheap to count and this is the shape of a bad
      # config behind a restart policy: the daemon looks present and even briefly running, so
      # neither alert above fires, while nothing it schedules ever gets far enough to run.
      - alert: SchedulerDaemonCrashLooping
        expr: increase(scheduler_daemon_restart_count[1h]) >= 3
        for: 10m
        labels:
          severity: critical
        annotations:
          summary: "Scheduler {{ $labels.container }} is crash-looping"
          description: "'{{ $labels.container }}' ({{ $labels.service }}) has restarted {{ $value }} times in the last hour. It is not staying up long enough to schedule reliably."
          runbook: "`docker logs {{ $labels.container }} | tail -20` — the same ofelia config-parse note as SchedulerDaemonDown applies."

  # Textfile collectors. node_exporter publishes the mtime of every file it reads, which is the
  # only honest staleness signal for a collector: the metrics themselves are re-served on every
  # scrape from a file that may be hours old, so their own timestamps prove nothing.
  - name: textfile-collectors
    rules:
      # The zfs collector runs @every 15s via ofelia-dockprom. Until now nothing alerted if it
      # stopped — the pool metrics would simply freeze at their last values and keep being
      # served, looking exactly like a healthy, unchanging pool.
      - alert: ZfsMetricsStale
        expr: time() - node_textfile_mtime_seconds{file=~"(.*/)?zfs-metrics\\.prom"} > 300
        for: 10m
        labels:
          severity: warning
        annotations:
          summary: "ZFS metrics have stopped updating"
          description: "zfs-metrics.prom has not been written in over 5 minutes (cadence is 15s). The zfs_* series are frozen at their last values, not absent — they will look healthy while telling you nothing."
          runbook: "Check `docker logs ofelia-dockprom` and that the zfs-utils container is running."

      # Catch-all for any other collector writing into this directory, including ones defined
      # outside this repo (the watchtower collector's container is not in this compose, so its
      # filename cannot be asserted here). Deliberately loose at 1h: it exists to notice a dead
      # collector at all, not to pin down cadence. The tightly-scoped rules above are excluded
      # so a single failure does not produce two alerts, and nh22_extractor.prom is excluded
      # because it legitimately goes ~17h between writes overnight and has its own alert group.
      #
      # nh22_cdbaby_reauth_reminder.prom is excluded on the same grounds and covered by
      # NH22CdbabyReauthReminderStale: it is written once a day at 05:10 MT, so under a 1h
      # threshold it was "stale" ~23 hours out of every 24 and warned daily, from the day the
      # collector was added (2026-08-05) until this exclusion.
      #
      # THAT IS THE STANDING HAZARD IN THIS RULE, not a one-off: the 1h threshold silently
      # assumes every collector in this directory writes at least hourly, and nothing enforces
      # that assumption at the point where a new collector is added. Any new writer with a
      # cadence slower than an hour lands here by default and pages every day until someone
      # notices. Adding a collector to this directory means deciding, in the same change,
      # whether it belongs on this rule or needs its own — an exclusion without a replacement
      # rule is not a fix, it is an unmonitored collector.
      - alert: TextfileCollectorStale
        # The doubled backslashes are required and are NOT a typo. This is an unquoted YAML
        # scalar, so `\\.` reaches PromQL verbatim; PromQL then unescapes the string literal to
        # `\.` for the regex engine. A single `\.` here is a PromQL parse error ("unknown escape
        # sequence"), which takes the whole rules file down, not just this rule.
        expr: time() - node_textfile_mtime_seconds{file!~"(.*/)?(zfs-metrics|oneshot_jobs|nh22_extractor|nh22_cdbaby_reauth_reminder)\\.prom"} > 3600
        for: 30m
        labels:
          severity: warning
        annotations:
          summary: "Textfile collector {{ $labels.file }} has stopped updating"
          description: "{{ $labels.file }} has not been written in over an hour. Its metrics are frozen at their last values rather than absent, so they will look healthy."
