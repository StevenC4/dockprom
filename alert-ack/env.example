# Copy to dockprom/env/alert-ack.env (that directory is gitignored) and fill these in.

# Bot token, xoxb-. Shared with the other homelab-slack-gateway backends.
# NOT the app-level xapp- token: that one is the gateway's alone and must not appear here.
#
# Scopes needed. The first was enough for the Resolve button; the rest are what auto-resolve
# added, and a missing one fails at the Slack call rather than at boot:
#   chat:write         post alerts, edit them green, reply in threads
#   reactions:write    mark legacy webhook-authored posts that cannot be edited
#   channels:history   find those legacy posts  (groups:history if #alerts is private)
# The bot must also be INVITED to the alert channel, or conversations.history answers
# `not_in_channel` and the backlog sweep silently finds nothing.
SLACK_BOT_TOKEN=

# The gateway's HMAC secret, for the Resolve button. Must be the SAME value the gateway signs
# with, or we 401 it and the button silently does nothing.
HOMELAB_GATEWAY_SECRET=

# ---------------------------------------------------------------------------------------------
# Below here is the Alertmanager path (posting alerts + auto-resolving them). Leave BOTH blank to
# keep it off: alert-ack then answers 503 on /alertmanager and Alertmanager keeps using its own
# incoming webhook exactly as before. Half-filled is the one state that is not supported.
# ---------------------------------------------------------------------------------------------

# Channel ID of #alerts (Cxxxxxxxx — the ID, not the name). Copy from the channel's About tab.
ALERT_CHANNEL=

# Shared bearer token, any long random string. Must match `authorization.credentials` on the
# alert-ack webhook receiver in alertmanager/config.yml. Generate with:
#   openssl rand -hex 32
ALERTMANAGER_WEBHOOK_TOKEN=
