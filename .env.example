# Template for the per-host environment file (gitignored). Secrets and local
# overrides ONLY. Host identity, role and compose files live in hosts/<host>/host.mk.
#
# Never print the real file, and never run a bare `docker compose config`: it
# interpolates this file and prints every value. `make config` validates quietly.

# mozart only (Grafana, docker-compose.mozart.yaml)
GF_ADMIN_USER=changeme
GF_ADMIN_PASSWORD=changeme

# Optional. Defaults to the host name. Used in prometheus.<name>.carroll.live.
# TRAEFIK_HOSTNAME=

# No longer read. The Makefile derives these from `hostname -s` and host.mk:
# HOSTNAME, ROLE
